{
  "name": "kicc-tralee-masjid",
  "version": "1.1.133",
  "type": "module",
  "description": "Kerry Islamic Cultural Centre website.",
  "main": "index.html",
  "repository": "git@github.com:traleemasjidkicc/traleemasjidkicc.github.io.git",
  "author": "Nazmul Alam <hello@nalam.me>",
  "license": "Apache License 2.0",
  "private": true,
  "engines": {
    "npm": "please-use-yarn",
    "yarn": ">= 4.0.0"
  },
  "packageManager": "yarn@4.17.0",
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "browser-sync": "2.29.1",
    "gulp": "4.0.2",
    "gulp-replace": "1.1.4"
  },
  "scripts": {
    "start": "npx gulp",
    "setup-hooks": "npx gulp setup-hooks",
    "verify": "yarn install --immutable --check-cache",
    "preci": "rm -rf node_modules",
    "ci": "yarn install --immutable",
    "postci": "yarn start",
    "precommit": "gulp precommit",
    "test:e2e": "playwright test",
    "test:e2e:headed": "PW_HEADED=1 playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "pretest:e2e": "node -e \"fetch('http://127.0.0.1:3000/').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>{console.error('Start the dev server first: yarn start');process.exit(1)})\""
  }
}
